{
  "openapi": "3.1.0",
  "info": {
    "title": "KING CLUB Singer LAN API",
    "version": "1.4.0",
    "description": "Native staff LAN client; Business requests require Bearer token; private-LAN discovery and one-use, five-minute four-digit pairing are additive exceptions. Accepted commands must be polled to completion. Optional additive audio capabilities; absent audio means controller upgrade required. Commands obey configured caps. A cappella mutes computer music only, preserving clock and microphone/FX. Hardware success requires actual readback."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4865/api/singer/v1"
    }
  ],
  "security": [
    {
      "SingerKey": []
    }
  ],
  "paths": {
    "/state": {
      "get": {
        "operationId": "getState",
        "responses": {
          "200": {
            "description": "Current authoritative desktop state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Invalid connection key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "LAN or Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/songs": {
      "get": {
        "operationId": "searchSongs",
        "responses": {
          "200": {
            "description": "Local catalog page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongPage"
                }
              }
            }
          },
          "401": {
            "description": "Invalid connection key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "LAN or Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "playlistId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter to playlist order; omit for full-library search."
          }
        ]
      }
    },
    "/songs/{id}/lyrics": {
      "get": {
        "operationId": "getLyrics",
        "responses": {
          "200": {
            "description": "Line-timed lyrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lyrics"
                }
              }
            }
          },
          "401": {
            "description": "Invalid connection key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "LAN or Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/commands/{id}": {
      "get": {
        "operationId": "getReceipt",
        "responses": {
          "200": {
            "description": "Command execution receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "Invalid connection key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "LAN or Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/commands": {
      "post": {
        "operationId": "submitCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted or existing receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "Invalid key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "State changed, busy, expired or ID reused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Desktop controller offline",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/info": {
      "get": {
        "operationId": "getControllerIdentity",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "nonce",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public identity and HMAC-SHA256 proof; no credential or pairing code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "service",
                    "controllerId",
                    "port",
                    "nonce",
                    "proof"
                  ],
                  "properties": {
                    "apiVersion": {
                      "const": 1
                    },
                    "service": {
                      "const": "kingclub-singer-v1"
                    },
                    "controllerId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer"
                    },
                    "nonce": {
                      "type": "string"
                    },
                    "proof": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "LAN or browser Origin rejected"
          }
        }
      }
    },
    "/pair": {
      "post": {
        "operationId": "pairTablet",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "controllerId",
                  "code"
                ],
                "properties": {
                  "controllerId": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{32}$"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{4}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paired; window consumed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "controllerId",
                    "token"
                  ],
                  "properties": {
                    "apiVersion": {
                      "const": 1
                    },
                    "controllerId": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Incorrect code; counts toward five attempts"
          },
          "403": {
            "description": "Pairing closed or source denied"
          },
          "409": {
            "description": "Controller identity changed"
          },
          "410": {
            "description": "Pairing expired"
          },
          "429": {
            "description": "Five failures; reopen pairing on desktop"
          },
          "503": {
            "description": "Gateway disabled"
          }
        }
      }
    },
    "/playlists": {
      "get": {
        "summary": "List local playlist categories without paths",
        "responses": {
          "200": {
            "description": "Playlist summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Playlist"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SingerKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Operation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "songId"
            ],
            "properties": {
              "type": {
                "const": "select"
              },
              "songId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "songId"
            ],
            "properties": {
              "type": {
                "const": "next"
              },
              "songId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "play"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "pause"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "restart"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "mode"
            ],
            "properties": {
              "type": {
                "const": "vocal_mode"
              },
              "mode": {
                "enum": [
                  "original",
                  "accompaniment"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "control",
              "value"
            ],
            "properties": {
              "type": {
                "const": "audio_level"
              },
              "control": {
                "enum": [
                  "music",
                  "microphone",
                  "microphone2",
                  "reverb"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "enabled"
            ],
            "properties": {
              "type": {
                "const": "acappella"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "semitones"
            ],
            "properties": {
              "type": {
                "const": "pitch"
              },
              "semitones": {
                "type": "integer",
                "minimum": -6,
                "maximum": 6
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "songId"
            ],
            "properties": {
              "type": {
                "const": "temporary_select"
              },
              "songId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "songId",
              "playlistId"
            ],
            "properties": {
              "type": {
                "const": "playlist_select"
              },
              "songId": {
                "type": "string"
              },
              "playlistId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "effect",
              "volume"
            ],
            "properties": {
              "type": {
                "const": "atmosphere"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "applause",
                  "cheer",
                  "scream",
                  "stop"
                ]
              },
              "volume": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "enabled"
            ],
            "properties": {
              "type": {
                "const": "auto_return_next"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "enabled"
            ],
            "properties": {
              "type": {
                "const": "front_light"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sessionId",
          "expectedRevision",
          "issuedAtUnixMs",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "sessionId": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "issuedAtUnixMs": {
            "type": "integer"
          },
          "operation": {
            "$ref": "#/components/schemas/Operation"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "status",
          "error",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "executing",
              "succeeded",
              "failed",
              "expired",
              "rejected",
              "cancelled"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "Song": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number"
          },
          "accompanimentAvailable": {
            "type": "boolean"
          },
          "lyricsAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "artist",
          "durationSeconds",
          "accompanimentAvailable",
          "lyricsAvailable"
        ]
      },
      "Playback": {
        "type": "object",
        "properties": {
          "loaded": {
            "type": "boolean"
          },
          "paused": {
            "type": "boolean"
          },
          "positionSeconds": {
            "type": "number"
          },
          "sampledAtUnixMs": {
            "type": "integer"
          },
          "clockFresh": {
            "type": "boolean"
          },
          "vocalMode": {
            "enum": [
              "original",
              "accompaniment"
            ]
          },
          "playbackMode": {
            "type": "string"
          },
          "volume": {
            "type": "number"
          },
          "pitchSemitones": {
            "type": "integer",
            "minimum": -6,
            "maximum": 6
          }
        },
        "required": [
          "loaded",
          "paused",
          "positionSeconds",
          "sampledAtUnixMs",
          "clockFresh",
          "vocalMode",
          "playbackMode",
          "volume"
        ]
      },
      "State": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "sessionId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "serverTimeUnixMs": {
            "type": "integer"
          },
          "controllerOnline": {
            "type": "boolean"
          },
          "deck": {
            "enum": [
              1,
              2
            ]
          },
          "song": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Song"
              },
              {
                "type": "null"
              }
            ]
          },
          "playback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Playback"
              },
              {
                "type": "null"
              }
            ]
          },
          "cueActive": {
            "type": "boolean"
          },
          "transitionBusy": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "audio": {
            "$ref": "#/components/schemas/Audio"
          },
          "audioPolicy": {
            "$ref": "#/components/schemas/AudioPolicy"
          },
          "controllerId": {
            "type": "string",
            "description": "Stable controller identity for paired address recovery"
          },
          "features": {
            "type": "object",
            "properties": {
              "pitch": {
                "type": "boolean"
              },
              "playlists": {
                "type": "boolean"
              },
              "temporarySelect": {
                "type": "boolean"
              }
            }
          },
          "playlist": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Playlist"
              },
              {
                "type": "null"
              }
            ]
          },
          "interlude": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "returnSong": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Song"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "returnPositionSeconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "returnRevision": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "apiVersion",
          "sessionId",
          "revision",
          "serverTimeUnixMs",
          "controllerOnline",
          "deck",
          "song",
          "playback",
          "cueActive",
          "transitionBusy",
          "busy"
        ]
      },
      "SongPage": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Song"
            }
          }
        },
        "required": [
          "total",
          "offset",
          "limit",
          "items"
        ]
      },
      "Lyrics": {
        "type": "object",
        "properties": {
          "songId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "atSeconds": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "atSeconds",
                "text"
              ]
            }
          },
          "timing": {
            "const": "line"
          },
          "clock": {
            "const": "mpv"
          }
        },
        "required": [
          "songId",
          "lines",
          "timing",
          "clock"
        ]
      },
      "AudioLevel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "available",
          "value",
          "reason"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AudioPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "microphone",
          "reverbBus",
          "musicMax",
          "microphoneMax",
          "reverbMax"
        ],
        "properties": {
          "microphone": {
            "enum": [
              "",
              "ch-1",
              "ch-2",
              "ch-6"
            ]
          },
          "reverbBus": {
            "enum": [
              "",
              "FX 1",
              "FX 2"
            ]
          },
          "musicMax": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "microphoneMax": {
            "type": "integer",
            "minimum": 0,
            "maximum": 77
          },
          "reverbMax": {
            "type": "integer",
            "minimum": 0,
            "maximum": 77
          },
          "microphone2": {
            "enum": [
              "",
              "ch-1",
              "ch-2",
              "ch-6"
            ],
            "default": ""
          },
          "microphone2Max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 77,
            "default": 77
          }
        }
      },
      "Audio": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "music",
          "microphone",
          "reverb",
          "acappella"
        ],
        "properties": {
          "music": {
            "$ref": "#/components/schemas/AudioLevel"
          },
          "microphone": {
            "$ref": "#/components/schemas/AudioLevel"
          },
          "reverb": {
            "$ref": "#/components/schemas/AudioLevel"
          },
          "acappella": {
            "type": "boolean"
          },
          "microphone2": {
            "$ref": "#/components/schemas/AudioLevel"
          }
        }
      },
      "Playlist": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "library",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "weekday",
              "event",
              "custom"

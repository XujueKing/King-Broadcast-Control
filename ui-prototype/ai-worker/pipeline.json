{
  "pipelineVersion": "king-audio-ai-moss-v7",
  "lyricsPostprocessVersion": "moss-native-monotonic-v2",
  "pythonVersion": "3.12",
  "concurrency": 1,
  "compute": {
    "device": "cuda:0",
    "dtype": "bfloat16",
    "requireCuda": true
  },
  "separator": {
    "architecture": "bs-roformer",
    "model": "model_bs_roformer_ep_317_sdr_12.9755.ckpt",
    "modelDirectory": "D:\\AI-Models\\audio-separator",
    "batchSize": 1,
    "overlap": 8,
    "fallbackModel": "htdemucs_ft",
    "fallbackShifts": 2,
    "fallbackOverlap": 0.5,
    "fallbackAccompaniment": ["drums", "bass", "other"]
  },
  "moss": {
    "model": "OpenMOSS-Team/MOSS-Music-8B-Thinking",
    "endpoint": "http://127.0.0.1:30000",
    "maxTokens": 8192,
    "temperature": 0.0,
    "timestampMode": "native"
  },
  "artifacts": [
    "vocals.flac",
    "no_vocals.flac",
    "lyrics.txt",
    "lyrics.lrc",
    "lyrics.words.json",
    "reference.json",
    "manifest.json"
  ]
}

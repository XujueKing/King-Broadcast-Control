{
  "name": "king-broadcast-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build:web": "vite build --configLoader native",
    "build": "npm run build:web && node scripts/prepare-sites-build.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "setup:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mpv.ps1 -Variant v3",
    "setup:kgma": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-kgm-decoder.ps1",
    "setup:audio-ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-audio-ai.ps1",
    "setup:vocal-generator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vocal-generator.ps1",
    "setup:moss-music": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-moss-music.ps1",
    "start:moss-music": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-moss-music.ps1",
    "check:moss-model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-moss-model.ps1",
    "check:audio-ai": ".venv-audio-ai\\Scripts\\python.exe ai-worker/worker.py --preflight",
    "test:audio-ai-worker": ".venv-audio-ai\\Scripts\\python.exe -m unittest discover -s ai-worker -p test_*.py",
    "test:vocal-generator": ".venv-vocal-generator\\Scripts\\python.exe -m unittest discover -s vocal-generator -p test_*.py",
    "tauri": "tauri",
    "preview": "vite preview",
    "test:runtime": "node --test tests/media-runtime.test.mjs",
    "test:media": "node --test tests/media-playback.test.mjs",
    "test:media-scan": "node --test tests/media-scan-stability.test.mjs",
    "test:rhythm": "node --test tests/rhythm-runtime.test.mjs",
    "test:rhythm-automation": "node --test tests/rhythm-automation.test.mjs",
    "test:lighting-automation": "node --test tests/lighting-automation.test.mjs",
    "test:lighting-package": "node --test tests/lighting-package.test.mjs",
    "test:titan-simulator": "node --test tests/titan-simulator.test.mjs",
    "test:video-color": "node --test tests/video-color-runtime.test.mjs",
    "test:lyrics": "node --test tests/lyrics-runtime.test.mjs",
    "test:desktop-smoke": "node --test tests/tauri-runtime-smoke.test.mjs",
    "test:desktop-output": "node --test tests/tauri-second-display.test.mjs",
    "test:desktop-mpv": "node --test tests/tauri-mpv-deck.test.mjs",
    "test:desktop-mpv-modes": "node --test tests/tauri-mpv-playback-modes.test.mjs",
    "test:desktop-video": "node --test tests/tauri-video-program.test.mjs",
    "test:desktop-text-parity": "node --test tests/tauri-text-output-parity.test.mjs",
    "test:qu16-protocol": "node --test tests/qu16-control.test.mjs",
    "test:qu16-output": "node --test tests/qu16-control.test.mjs tests/deck-cue.test.mjs tests/qu16-output-baseline.test.mjs",
    "test:qu16-frontend": "node scripts/test-qu16-control-frontend-qa.mjs",
    "test:qu16-controls": "node --test tests/qu16-control.test.mjs && node scripts/test-qu16-control-frontend-qa.mjs && node scripts/test-rotary-qa.mjs && node scripts/test-panel-lamp-qa.mjs && node scripts/test-superstrip-layout-qa.mjs && node scripts/test-superstrip-function-qa.mjs && node scripts/test-surface-function-qa.mjs && node scripts/test-touchscreen-qa.mjs && node scripts/test-monitor-bank-qa.mjs",
    "test:qu16-surface": "node scripts/test-surface-function-qa.mjs",
    "test:desktop-kingsong": "node --test tests/tauri-kingsong.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KING CLUB Broadcast Control",
  "version": "0.1.0",
  "identifier": "club.king.broadcast-control",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KING CLUB Broadcast Control",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "visible": true,
        "focus": true,
        "maximized": false,
        "decorations": false,
        "theme": "Dark",
        "resizable": true,
        "fullscreen": true
      },
      {
        "label": "output",
        "title": "KING CLUB LED Output",
        "url": "output.html",
        "width": 960,
        "height": 1080,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.local-tools/mpv/mpv.exe": "mpv.exe",
      "../.local-tools/mpv/libmpv-2.dll": "libmpv-2.dll",
      "../.local-tools/kgm-decoder/kgm-decoder.exe": "kgm-decoder.exe",
      "../third-party/kgm-decoder-LICENSE.txt": "licenses/kgm-decoder-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
